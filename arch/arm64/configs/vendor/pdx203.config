CONFIG_MACH_SONY_PDX203=y
# Android 17's task_profiles.json drives CPU QoS through uclamp
# (cpu.uclamp.min/max/latency_sensitive) and never touches schedtune, while this
# kernel shipped with SCHED_TUNE=y and UCLAMP_TASK=n -- and A17's cgroups.json
# does not even declare the schedtune controller, so /dev/stune is never mounted.
# Net effect on the port: the whole scheduler QoS layer was inert. The two are
# mutually exclusive in Kconfig (SCHED_TUNE depends on !UCLAMP_TASK), so enabling
# uclamp drops schedtune -- which costs nothing, because it was already unused.
# Verified before building: cpu_legacy_files[] (cgroup v1, which is where this
# device's cpu controller lives) does carry uclamp.min/max/latency_sensitive.
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
